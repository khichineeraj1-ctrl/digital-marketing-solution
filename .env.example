# Canonical public origin — used for canonicals, sitemap, OG, JSON-LD. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.example.com
# Where the logged-in products live (legacy; unused).
NEXT_PUBLIC_APP_URL=https://app.example.com
# Optional: enquiries are POSTed here as JSON (CRM / Slack / Zapier / your API). Always also appended to data/leads.json.
ENQUIRY_WEBHOOK_URL=
# Set to "1" on staging so everything is noindex.
NEXT_PUBLIC_NOINDEX=
# Search Console verification token (optional)
GOOGLE_SITE_VERIFICATION=

# Admin panel (/admin). Use a strong password; secret signs the session cookie.
ADMIN_PASSWORD=
ADMIN_SECRET=

# Product apps (separate platforms). Site links OUT to these; no accounts are created here.
# Business Profile has no app/login: clients add this Google account as a manager of their profile
NEXT_PUBLIC_GBP_MANAGER_EMAIL=profiles@example.com
NEXT_PUBLIC_CREATOR_APP_URL # influencer marketplace platform: brands AND creators log in here=https://creators.example.com
NEXT_PUBLIC_ADS_APP_URL=https://ads.example.com
# Optional: shown on the thank-you page after an enquiry
NEXT_PUBLIC_BOOKING_URL=
NEXT_PUBLIC_WHATSAPP=

# Persistent storage for admin data. On Railway: mount a Volume at /data and set DATA_DIR=/data
DATA_DIR=
